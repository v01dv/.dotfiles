// -*- mode: jsonc -*-
{
  "layer": "top", // Waybar at top layer
  "position": "top", // Waybar position (top|bottom|left|right)
  // "height": 30, // Waybar height (to be removed for auto height)
  // "width": 1280, // Waybar width
  "spacing": 3, // Gaps between modules (4px)
  "reload_style_on_change": true,
  // Choose the order of the modules
  "modules-left": ["hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "network",
    "temperature",
    "load",
    // "cpu",
    "memory",
    "battery",
    "bluetooth",
    "pulseaudio",
    "clock",
    "hyprland/language",
  ],
  // Modules configuration
  "hyprland/window": {
    "max-length": 150,
  },

  "battery": {
    "interval": 2,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": "󱟢 100%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo} ({power:0.1f} W)",
    "on-click": "kitty battop",
  },

  "bluetooth": {
    "format": "󰂯 ON",
    "format-off": "󰂲 OFF",
    // "format-disabled": "", // an empty format will hide the module
    "format-disabled": "󰂲 OFF",
    "format-connected": "󰂱 {num_connections}",
    "format-connected-battery": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected:\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "kitty bluetui",
    "on-click-right": "bluetoothctl power toggle",
    // "on-click": "exec ghostty --title=bluetui -e bluetui"
  },

  "load": {
    "interval": 1,
    "format": "⣾⣄  {load1} {load5} {load15}",
  },
  "cpu": {
    "interval": 1,
    // "format": " {usage}%",
    "format": "{icons} {usage}% ",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "states": {
      "warning": 70,
      "critical": 90,
    },
    "tooltip": true,
    "on-click": "kitty btop",
  },

  "memory": {
    "interval": 30,
    // "format": " {}%",
    "format": " {used:0.1f}G/{total:0.1f}G",
  },
  "network": {
    "format-wifi": "  {essid} ({signalStrength}%)",
    "format-ethernet": "󰈀 Wired",
    "format-disconnected": "󰖪 󰤭 Off",
    "max-length": 30,
    "tooltip-format": "{ifname} via {gwaddr}\nIP: {ipaddr}/{cidr}\nSignal: {signaldBm}dBm ({signalStrength}%)",
    // "on-click": "kitty wlctl",
    "on-click": "exec nmrs",
    "on-click-right": "kitty bandwhich",
  },

  "clock": {
    // "timezone": "America/New_York",
    "format": "󰥔 {:%H:%M}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "format": {
        "today": "<span color = '#8caaee'><b>{}</b></span>",
      },
    },
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "🇺🇸",
    "format-uk": "🇺🇦",
  },
  "hyprland/workspaces": {
    "format": "{name}: {icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      // "urgent": "",
      // "active": "",
      // "default": "",
    },
    "persistent-workspaces": {
      "*": 5, // 5 workspaces by default on every monitor
      "LVDS-1": 3, // but only three on LVDS-1
      // "*": [2, 3, 4, 5], // 2-5 on every monitor
      // "HDMI-A-1": [1], // but only workspace 1 on HDMI-A-1
    },
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""],
    "on-click": "kitty btop",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰋎 {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "kitty wiremix",
    // "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +1%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -1%",
  },
}
