#################################
#            Font               #
#################################
# Microsoft has updated its Cascadia Code font with a new Nerd Font variant.
#
# In addition to all of the above characters, the Cascadia family now comes with 
# a native "Nerd Font" variant! It includes the entire set of glyphs as of April
# 2024 (all 9209 of them), and supersedes both unofficial variants "Caskaydia 
# Cove" and "Delugia Code".
#   https://github.com/microsoft/cascadia-code/releases
font-family = "Cascadia Code"

# https://github.com/subframe7536/maple-font
# font-family = "Maple Mono Normal NF CN"

# https://github.com/ryanoasis/nerd-fonts/tree/master/patched-fonts/NerdFontsSymbolsOnly
# Pick your font family:
#   If you are limited to monospaced fonts (because of your terminal, etc) then pick a font with Nerd Font Mono (or NFM).
#   If you want to have bigger icons (usually around 1.5 normal letters wide) pick a font without Mono i.e. Nerd Font (or NF). Most terminals support this, but ymmv.
#   If you work in a proportional context (GUI elements or edit a presentation etc) pick a font with Nerd Font Propo (or NFP).
font-family = "Symbols Nerd Font"
# font-family = "NotoColorEmoji"
font-size = 10

# adjustment of maximum height for nerd font icons
adjust-icon-height = -32%

# stylistic alternates (italic only) 
font-feature = ss01 

# alternate not equal
font-feature = ss02

# slashed zero
font-feature = ss19

# graphical control characters
font-feature = ss20

# Disable ligature
# font-feature = -liga

# Bold text uses bright colors
bold-is-bright = true

#################################
#            Theme              #
#################################
palette-generate = false
# theme = catppuccin-frappe
# theme = TokyoNight Storm
theme = Catppuccin Frappe
window-padding-y = 0

# The cursor-style only works though when shell-integration-features = no-cursor is present.
cursor-style = block
cursor-style-blink = false
# cursor-opacity = 0.95
adjust-cursor-thickness = 1
cursor-color = #81c8be

# Support changing the cursor style for unfocused windows:
# https://github.com/ghostty-org/ghostty/discussions/3750
# https://github.com/ghostty-org/ghostty/pull/2818
# This option will be added soon.
#
# cursor-style-unfocused =

# https://github.com/ghostty-org/ghostty/issues/2023
window-decoration = none

# Resize overlay settings
resize-overlay = never

mouse-hide-while-typing = true
confirm-close-surface = false
desktop-notifications = false
quit-after-last-window-closed = false

# Changing the shell-integration-features require a full restart of ghostty
# instead of just reloading the configuration. Because it injects code into your
# shell. And we can't uninject code without restarting ghostty or restarting
# shell then sourcing the shell integration code again.
# shell-integration-features = no-cursor, no-sudo, title
shell-integration-features = no-cursor, title

# Space between lines
# adjust-cell-height = 35%

gtk-titlebar = false
# gtk-adwaita = false
gtk-single-instance = true

# https://michaelbommarito.com/wiki/programming/tools/ghostty-configuration/
#
# Scrollback buffer
# Balance between history retention and memory usage.
# Each byte stores one character of history. adjust based on your workflow:
#  - minimal (1mb): 1000000 - for resource-constrained systems
#  - standard (10mb): 10000000 - good for most users
#  - extensive (100mb): 100000000 - for heavy log analysis
scrollback-limit = 100000000

#################################
#      Advanced features        #
#################################
# Custom shaders (optional - for visual effects)
# custom-shader = /path/to/shader.glsl
# custom-shader-animation = false

# Linux-specific optimizations
# Control resource usage per terminal instance:
linux-cgroup = single-instance
# Memory limit per terminal (2GB)
linux-cgroup-memory-limit = 2147483648
# Process limit per terminal
linux-cgroup-processes-limit = 1000

# Quake-style dropdown terminal
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
quick-terminal-autohide = true

#################################
#            Keybinds           #
#################################
# Default value:
# keybind = ctrl+shift+c=copy_to_clipboard
# keybind = ctrl+shift+v=paste_from_clipboard
# keybind = shift+insert=paste_from_selection

keybind = alt+c=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard

# keybind = alt+v=paste_from_clipboard
# keybind = alt+v=paste_from_selection
# keybind = shift+insert=paste_from_selection

keybind = alt+one=unbind
keybind = alt+two=unbind
keybind = alt+three=unbind
keybind = alt+four=unbind
keybind = alt+five=unbind
keybind = alt+six=unbind
keybind = alt+seven=unbind
keybind = alt+eight=unbind
keybind = alt+nine=unbind
keybind = shift+enter=text:\x1b\r

# keybind = ctrl+grave=toggle_quick_terminal
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# custom-shader = shaders/cursor.glsl


